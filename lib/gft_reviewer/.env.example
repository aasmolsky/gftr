# Example environment variables for gft_reviewer
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real tokens.

# Environment: development | test | production
# Rails app requires production + LLM_MODEL + LLM_API_KEY (API mode).
# development/test: dry run for individual tasks in specs/CLI — pipelines need API mode.
FRAI_ENV=production

# LLM (optional — if set, frai calls the API; if not set, CLI mode)
LLM_MODEL=
LLM_API_KEY=
