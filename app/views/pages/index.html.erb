<% if current_user %>
  <%# ── Loading overlay ── %>
  <div id="loading-overlay" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.75); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:1rem; padding:2rem 2.5rem; display:flex; flex-direction:column; align-items:center; gap:0.75rem; box-shadow:0 25px 50px rgba(0,0,0,0.4); min-width:220px; text-align:center;">
      <div style="width:40px; height:40px; border:4px solid var(--primary-color, #1e3a8a); border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite;"></div>
      <div style="color:#111827; font-size:1rem; font-weight:600;">Analyzing reviews…</div>
      <div style="color:#6b7280; font-size:0.8rem;">Please wait, this may take a moment</div>
    </div>
  </div>
  <style>@keyframes spin { to { transform: rotate(360deg); } }</style>

  <div class="card">
    <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem;">Please enter Place ID</h2>
    <%= form_with url: query_path, method: :post, local: true, html: { id: "analyze-form" } do |form| %>
      <div class="form-group">
        <%= form.text_area :query, placeholder: "Enter Google Maps Place ID here...", rows: 1 %>
        <div style="margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-muted); line-height: 1.4;">
          Don't know the ID?
          <a href="https://developers.google.com/maps/documentation/places/web-service/place-id#find-id"
             target="_blank" style="color: var(--primary-color); text-decoration: none; font-weight: 500;">
            Find it on Google Maps
          </a>
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <%= form.label :hl, "Language:", style: "font-size: 0.875rem; font-weight: 500; color: var(--text-muted);" %>
          <%= form.select :hl, [
            ["Arabic","ar"],["Chinese (Simplified)","zh-cn"],["Chinese (Traditional)","zh-tw"],
            ["Dutch","nl"],["English","en"],["French","fr"],["German","de"],["Greek","el"],
            ["Hindi","hi"],["Indonesian","id"],["Italian","it"],["Japanese","ja"],["Korean","ko"],
            ["Polish","pl"],["Portuguese","pt"],["Russian","ru"],["Spanish","es"],
            ["Thai","th"],["Turkish","tr"],["Vietnamese","vi"]
          ].sort_by { |name, _| name }, { selected: session[:hl] || "en" },
          { style: "padding: 0.25rem 0.5rem; border-radius: 0.375rem; border: 1px solid var(--border-color); font-size: 0.875rem;" } %>
        </div>
        <%= form.submit "Analyze Reviews", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card" style="border-left: 4px solid var(--primary-color);">
    <% if @last_analysis == "not_found" %>
      <div style="text-align: center; padding: 2rem 0;">
        <h3 style="color: #991b1b;">Place not found</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted);">Please try a valid Google Maps Place ID.</p>
      </div>
    <% else %>
      <% public_data = (@last_request&.place_data_json || {}).with_indifferent_access %>
      <% analysis    = (@last_request&.frai_result_json || (@last_analysis.is_a?(Hash) ? @last_analysis : {})).with_indifferent_access %>
      <% assessment  = analysis[:manipulation_assessment].to_s %>
      <% verdict_color = assessment == "likely_fake" ? "#dc2626" : assessment == "likely_real" ? "#059669" : "#b45309" %>
      <% verdict_label = assessment == "likely_fake" ? "🔴 Likely Fake" : assessment == "likely_real" ? "🟢 Likely Real" : "🟡 Mixed" %>
      <% rc = (analysis[:rating_categories] || {}).with_indifferent_access %>

      <%# ── 1. HEADER ── %>
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--primary-color);">
          <%= public_data[:title] || "Analysis Result" %>
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: baseline;">
          <span style="font-size: 1.2rem; font-weight: 700; color: <%= verdict_color %>;"><%= verdict_label %></span>
          <span style="font-size: 0.875rem; color: var(--text-muted);">
            <strong><%= analysis[:authenticity_score] || 0 %>%</strong> not flagged as fake
          </span>
          <span style="font-size: 0.875rem;">Public: <strong><%= public_data[:rating] || analysis[:calculated_rating] || "—" %> ★</strong></span>
          <% real_rating = analysis[:real_only_average_rating].to_f %>
          <% real_rating_display = real_rating < 1.0 ? (real_rating == 0.0 ? "—" : "1.0") : real_rating %>
          <span style="font-size: 0.875rem; color: #059669;">Without fakes: <strong><%= real_rating_display %><%= real_rating_display == "—" ? "" : " ★" %></strong></span>
          <% est_rating = analysis[:estimated_rating].to_f %>
          <% if est_rating > 0 %>
            <span style="font-size: 0.875rem; color: #b45309;">Estimated: <strong><%= est_rating %> ★</strong></span>
          <% end %>
          <span style="font-size: 0.875rem; color: var(--text-muted);">
            Analyzed <strong><%= analysis[:analyzed_ratings_count] || 0 %></strong> —
            <span style="color:#dc2626;"><strong><%= analysis[:fake_count] || 0 %></strong> fake</span>,
            <span style="color:#059669;"><strong><%= analysis[:real_count] || 0 %></strong> real</span>
            <% if (analysis[:uncertain_count] || 0).to_i > 0 %>
              , <span style="color:#b45309;"><strong><%= analysis[:uncertain_count] %></strong> uncertain</span>
            <% end %>
          </span>
        </div>
      </div>

      <%# ── 2. SIGNAL SUMMARY ── %>
      <% signal_summary = (analysis[:signal_summary] || {}).with_indifferent_access %>
      <% if signal_summary.present? %>
        <% fake_keys = %w[THIN_ACCOUNT_0 THIN_ACCOUNT_1 SHORT_TEXT_EXTREME SHORT_TEXT BURST_AFTER_NEGATIVE FIVE_STAR_EMPTY SURNAME_REPEAT GENERIC_TEXT SUSPICIOUS_NEGATIVE MARKETING_TONE EMOJI_SPAM TEMPLATE_CLONE] %>
        <% signal_labels = {
          "THIN_ACCOUNT_0"       => "New accounts (0–1 reviews)",
          "THIN_ACCOUNT_1"       => "Thin accounts (2–3 reviews)",
          "SHORT_TEXT_EXTREME"   => "Very short text",
          "SHORT_TEXT"           => "Short text",
          "BURST_AFTER_NEGATIVE" => "Burst after negative review",
          "FIVE_STAR_EMPTY"      => "Empty 5★ reviews",
          "SURNAME_REPEAT"       => "Repeated surnames",
          "GENERIC_TEXT"         => "Generic, no details",
          "SUSPICIOUS_NEGATIVE"  => "Suspicious negative",
          "MARKETING_TONE"       => "Marketing tone",
          "EMOJI_SPAM"           => "Emoji / punctuation spam",
          "TEMPLATE_CLONE"       => "Template clones",
          "EDITED_REVIEW"        => "Edited after posting",
          "HAS_PHOTOS"           => "Includes photos",
          "EXPERIENCED_AUTHOR_5" => "Author >5 reviews",
          "EXPERIENCED_AUTHOR_10"=> "Author >10 reviews",
          "ACTIVE_PROFILE"       => "Active profile",
          "LONG_TEXT"            => "Detailed long text",
          "SPECIFIC_DETAILS"     => "Specific details",
          "BALANCED_TONE"        => "Balanced tone",
          "NATURAL_LANGUAGE"     => "Natural language",
          "LOCAL_GUIDE"          => "Local Guide",
          "OWNER_RESPONDED"      => "Owner responded",
          "HELPFUL_VOTES"        => "Has helpful votes"
        } %>
        <% fake_signals  = signal_summary.select { |k, _| fake_keys.include?(k.to_s) }.sort_by { |_, v| -v.to_i }.first(5) %>
        <% real_signals  = signal_summary.reject { |k, _| fake_keys.include?(k.to_s) }.sort_by { |_, v| -v.to_i }.first(5) %>
        <% total_reviews = analysis[:analyzed_ratings_count].to_i %>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1rem;">
          <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:0.75rem; padding:0.875rem;">
            <div style="font-size:0.78rem; font-weight:700; color:#991b1b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.6rem;">Manipulation indicators</div>
            <% if fake_signals.any? %>
              <% fake_signals.each do |key, count| %>
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.8rem; padding:0.2rem 0; border-bottom:1px solid #fee2e2;">
                  <span style="color:#7f1d1d;"><%= signal_labels[key.to_s] || key.to_s.downcase.gsub("_"," ") %></span>
                  <span style="font-weight:700; color:#dc2626;"><%= count %> rev.</span>
                </div>
              <% end %>
            <% else %>
              <div style="font-size:0.8rem; color:#7f1d1d;">No manipulation signals detected</div>
            <% end %>
          </div>

          <div style="background:#f0fdf4; border:1px solid #86efac; border-radius:0.75rem; padding:0.875rem;">
            <div style="font-size:0.78rem; font-weight:700; color:#166534; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.6rem;">Authenticity indicators</div>
            <% if real_signals.any? %>
              <% real_signals.each do |key, count| %>
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.8rem; padding:0.2rem 0; border-bottom:1px solid #bbf7d0;">
                  <span style="color:#14532d;"><%= signal_labels[key.to_s] || key.to_s.downcase.gsub("_"," ") %></span>
                  <span style="font-weight:700; color:#16a34a;"><%= count %> rev.</span>
                </div>
              <% end %>
            <% else %>
              <div style="font-size:0.8rem; color:#14532d;">No authenticity signals detected</div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── 3. CATEGORY BLOCKS ── %>
      <% [
        { key: :positive, label: "Positive",  stars: "4–5 ★", bg: "#f0fdf4", border: "#86efac", hdr: "#166534", txt: "#14532d" },
        { key: :neutral,  label: "Neutral",   stars: "3 ★",   bg: "#fffbeb", border: "#fde68a", hdr: "#92400e", txt: "#78350f" },
        { key: :negative, label: "Negative",  stars: "1–2 ★", bg: "#fef2f2", border: "#fca5a5", hdr: "#991b1b", txt: "#7f1d1d" }
      ].each do |cat| %>
        <% cat_data = (rc[cat[:key]] || {}).with_indifferent_access %>
        <% next if cat_data[:count].to_i == 0 %>
        <div style="background:<%= cat[:bg] %>; border:1px solid <%= cat[:border] %>; border-radius:0.75rem; padding:1rem; margin-bottom:0.75rem;">
          <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.5rem;">
            <div style="font-size:0.95rem; font-weight:700; color:<%= cat[:hdr] %>;"><%= cat[:label] %> (<%= cat[:stars] %>)</div>
            <div style="font-size:0.8rem; color:var(--text-muted);"><%= cat_data[:share_percent] || 0 %>% of analyzed</div>
          </div>
          <div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.875rem; color:<%= cat[:txt] %>;">
            <span>Total: <strong><%= cat_data[:count] || 0 %></strong></span>
            <span style="color:#059669;">Real: <strong><%= cat_data[:real] || 0 %></strong> (<%= cat_data[:genuine_percent] || 0 %>%)</span>
            <span style="color:#dc2626;">Fake: <strong><%= cat_data[:fake] || 0 %></strong></span>
            <% if (cat_data[:uncertain] || 0).to_i > 0 %>
              <span style="color:#b45309;">Uncertain: <strong><%= cat_data[:uncertain] %></strong></span>
            <% end %>
            <% if (cat_data[:avg_rating] || 0).to_f > 0 %>
              <span style="color:var(--text-muted);">Avg: <strong><%= cat_data[:avg_rating] %> ★</strong></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── 4. KEY CONCLUSIONS ── %>
      <% conclusions = Array(analysis[:key_conclusions] || analysis[:key_tendencies]) %>
      <% if conclusions.any? %>
        <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:0.5rem; padding:1rem; margin-bottom:1rem;">
          <div style="font-size:0.78rem; font-weight:700; color:#1d4ed8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Key Conclusions</div>
          <ul style="font-size:0.875rem; color:#1e3a8a; margin:0; padding-left:1.25rem;">
            <% conclusions.first(7).each { |c| %><li><%= c %></li><% } %>
          </ul>
        </div>
      <% end %>

      <%# ── error ── %>
      <% if analysis[:error].present? %>
        <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:0.5rem; padding:1rem;">
          <div style="font-size:0.875rem; font-weight:700; color:#991b1b; margin-bottom:0.25rem;">Analysis Error</div>
          <div style="font-size:0.875rem; color:#b91c1c;"><%= analysis.dig(:error, :message) || analysis[:error] %></div>
        </div>
      <% end %>
    <% end %>
  </div>

  <script>
    document.getElementById('analyze-form').addEventListener('submit', function() {
      document.getElementById('loading-overlay').style.display = 'flex';
    });
  </script>

<% else %>
  <div class="card" style="text-align:center; padding:3rem 2rem;">
    <h2 style="margin-bottom:1rem;">Welcome to GFTR</h2>
    <p style="color:var(--text-muted); margin-bottom:2rem;">Please log in with your Google account to start analyzing reviews.</p>
    <%= button_to "Login with Google", "/auth/google_oauth2", method: :post, class: "btn btn-primary",
        data: { turbo: false }, style: "padding:0.75rem 2rem; font-size:1rem;" %>
  </div>
<% end %>
