<% if current_user %>
  <%# ── Loading overlay ── %>
  <div id="loading-overlay" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.75); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:1rem; padding:2rem 2.5rem; display:flex; flex-direction:column; align-items:center; gap:0.6rem; box-shadow:0 25px 50px rgba(0,0,0,0.4); min-width:260px; max-width:340px; text-align:center;">
      <div style="width:44px; height:44px; border:4px solid var(--primary-color, #1e3a8a); border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite;"></div>
      <div style="color:#111827; font-size:1rem; font-weight:700; margin-top:0.25rem;">Analyzing reviews…</div>
      <div style="color:#6b7280; font-size:0.82rem; line-height:1.5;">
        AI model is classifying each review individually.<br>
        This usually takes <strong style="color:#374151;">30–90 seconds</strong> — please don't close the page.
      </div>
    </div>
  </div>
  <style>@keyframes spin { to { transform: rotate(360deg); } }</style>

  <div class="card">
    <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem;">Please enter Place ID</h2>
    <%= form_with url: query_path, method: :post, local: true, html: { id: "analyze-form" } do |form| %>
      <div class="form-group">
        <%= form.text_area :query, placeholder: "Enter Google Maps Place ID here...", rows: 1 %>
        <div style="padding:0.6rem 0 0.2rem 5px; font-size:0.8rem; color:var(--text-muted);">
          Don't know the ID?
          <a href="https://developers.google.com/maps/documentation/places/web-service/place-id#find-id"
             target="_blank" style="color:var(--primary-color); text-decoration:none; font-weight:500;">Find it on Google Maps ↗</a>
        </div>
      </div>
      <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-top:0.75rem; border-top:1px solid var(--border-color);">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <%= form.label :hl, "Language:", style: "font-size:0.875rem; font-weight:500; color:var(--text-muted); white-space:nowrap;" %>
          <%= form.select :hl, [
            ["Arabic","ar"],["Chinese (Simplified)","zh-cn"],["Chinese (Traditional)","zh-tw"],
            ["Dutch","nl"],["English","en"],["French","fr"],["German","de"],["Greek","el"],
            ["Hindi","hi"],["Indonesian","id"],["Italian","it"],["Japanese","ja"],["Korean","ko"],
            ["Polish","pl"],["Portuguese","pt"],["Russian","ru"],["Spanish","es"],
            ["Thai","th"],["Turkish","tr"],["Vietnamese","vi"]
          ].sort_by { |name, _| name }, { selected: session[:hl] || "en" },
          { style: "padding:0.25rem 0.5rem; border-radius:0.375rem; border:1px solid var(--border-color); font-size:0.875rem; background:white;" } %>
        </div>
        <%= form.submit "Analyze Reviews", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card" style="border-left: 4px solid var(--primary-color);">
    <% if @last_request.nil? && @last_analysis.nil? %>
      <%# ── Empty state for a fresh / new user ── %>
      <div style="text-align:center; padding:2.5rem 1.5rem;">
        <div style="font-size:3rem; margin-bottom:1rem;">🔍</div>
        <h3 style="font-size:1.2rem; font-weight:700; color:var(--primary-color); margin-bottom:0.5rem;">Ready to analyze</h3>
        <p style="color:var(--text-muted); font-size:0.9rem; max-width:380px; margin:0 auto 1.5rem;">
          Enter a Google Maps Place ID above and we'll check how many reviews look genuine — and how many don't.
        </p>
        <div style="display:flex; justify-content:center; gap:2rem; flex-wrap:wrap; font-size:0.8rem; color:var(--text-muted);">
          <span>🤖 AI classifies each review</span>
          <span>📊 Fake / real / uncertain counts</span>
          <span>⭐ Corrected rating estimate</span>
        </div>
      </div>
    <% elsif @last_analysis == "not_found" %>
      <div style="text-align: center; padding: 2rem 0;">
        <h3 style="color: #991b1b;">Place not found</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted);">Please try a valid Google Maps Place ID.</p>
      </div>
    <% else %>
      <% public_data = (@last_request&.place_data_json || {}).with_indifferent_access %>
      <% analysis    = (@last_request&.frai_result_json || (@last_analysis.is_a?(Hash) ? @last_analysis : {})).with_indifferent_access %>
      <% assessment  = analysis[:manipulation_assessment].to_s %>
      <% verdict_color = assessment == "untrusted" ? "#dc2626" : assessment == "trusted" ? "#059669" : "#b45309" %>
      <% verdict_label = assessment == "untrusted" ? "🔴 Untrusted" : assessment == "trusted" ? "🟢 Trusted" : "🟡 Like Truth" %>
      <% rc = (analysis[:rating_categories] || {}).with_indifferent_access %>

      <%# ── 1. HEADER ── %>
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--primary-color);">
          <%= public_data[:title] || "Analysis Result" %>
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: baseline;">
          <% verdict_bg = assessment == "untrusted" ? "#fef2f2" : assessment == "trusted" ? "#f0fdf4" : "#fffbeb" %>
          <% verdict_border = assessment == "untrusted" ? "#fca5a5" : assessment == "trusted" ? "#86efac" : "#fcd34d" %>
          <span style="font-size: 1.1rem; font-weight: 700; color: <%= verdict_color %>; background: <%= verdict_bg %>; border: 2px solid <%= verdict_border %>; border-radius: 0.5rem; padding: 0.25rem 0.75rem; display: inline-block;"><%= verdict_label %></span>
          <% est_rating = analysis[:estimated_rating].to_f %>
          <% if est_rating > 0 %>
            <span style="font-size: 1rem; font-weight: 700; color: #92400e; background:#fff7ed; border:1px solid #fed7aa; border-radius:0.375rem; padding:0.2rem 0.6rem;">
              Estimated: <strong><%= est_rating %> ★</strong>
            </span>
          <% end %>
          <span style="font-size: 0.875rem;">Public: <strong><%= public_data[:rating] || analysis[:calculated_rating] || "—" %> ★</strong></span>
          <span style="font-size: 0.875rem; color: var(--text-muted);">
            <strong><%= analysis[:authenticity_score] || 0 %>%</strong> flagged as fake
          </span>
          <span style="font-size: 0.875rem; color: var(--text-muted);">
            Analyzed <strong><%= analysis[:analyzed_ratings_count] || 0 %></strong> —
            <span style="color:#dc2626;"><strong><%= analysis[:fake_count] || 0 %></strong> fake</span>,
            <span style="color:#059669;"><strong><%= analysis[:real_count] || 0 %></strong> real</span>
            <% if (analysis[:uncertain_count] || 0).to_i > 0 %>
              , <span style="color:#b45309;"><strong><%= analysis[:uncertain_count] %></strong> uncertain</span>
            <% end %>
          </span>
        </div>
      </div>

      <%# ── 2. CATEGORY BLOCKS ── %>
      <% [
        { key: :positive, label: "Positive",  stars: "4–5 ★", bg: "#f0fdf4", border: "#86efac", hdr: "#166534", txt: "#14532d" },
        { key: :neutral,  label: "Neutral",   stars: "3 ★",   bg: "#fffbeb", border: "#fde68a", hdr: "#92400e", txt: "#78350f" },
        { key: :negative, label: "Negative",  stars: "1–2 ★", bg: "#fef2f2", border: "#fca5a5", hdr: "#991b1b", txt: "#7f1d1d" }
      ].each do |cat| %>
        <% cat_data = (rc[cat[:key]] || {}).with_indifferent_access %>
        <% next if cat_data[:count].to_i == 0 %>
        <div style="background:<%= cat[:bg] %>; border:1px solid <%= cat[:border] %>; border-radius:0.75rem; padding:1rem; margin-bottom:0.75rem;">
          <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.5rem;">
            <div style="font-size:0.95rem; font-weight:700; color:<%= cat[:hdr] %>;"><%= cat[:label] %> (<%= cat[:stars] %>)</div>
            <div style="font-size:0.8rem; color:var(--text-muted);"><%= cat_data[:share_percent] || 0 %>% of analyzed</div>
          </div>
          <div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.875rem; color:<%= cat[:txt] %>;">
            <span>Total: <strong><%= cat_data[:count] || 0 %></strong></span>
            <span style="color:#059669;">Real: <strong><%= cat_data[:real] || 0 %></strong> (<%= cat_data[:genuine_percent] || 0 %>%)</span>
            <span style="color:#dc2626;">Fake: <strong><%= cat_data[:fake] || 0 %></strong></span>
            <% if (cat_data[:uncertain] || 0).to_i > 0 %>
              <span style="color:#b45309;">Uncertain: <strong><%= cat_data[:uncertain] %></strong></span>
            <% end %>
            <% if (cat_data[:avg_rating] || 0).to_f > 0 %>
              <span style="color:var(--text-muted);">Avg: <strong><%= cat_data[:avg_rating] %> ★</strong></span>
            <% end %>
          </div>
          <% manip = cat_data[:manipulation_signals].to_i; auth = cat_data[:authenticity_signals].to_i %>
          <% if manip > 0 || auth > 0 %>
            <div style="display:flex; gap:1rem; margin-top:0.5rem; font-size:0.8rem;">
              <% if manip > 0 %>
                <span style="color:#dc2626;">⚠ <strong><%= manip %></strong> manipulation markers</span>
              <% end %>
              <% if auth > 0 %>
                <span style="color:#059669;">✓ <strong><%= auth %></strong> authenticity markers</span>
              <% end %>
            </div>
          <% end %>

          <% suspicious = Array(cat_data[:suspicious_reviews]) %>
          <% if suspicious.any? %>
            <details style="margin-top:0.75rem;">
              <summary style="font-size:0.8rem; font-weight:600; color:<%= cat[:hdr] %>; cursor:pointer; user-select:none; list-style:none; display:flex; align-items:center; gap:0.4rem;">
                <span style="font-size:0.7rem;">▶</span> Top suspicious reviews (<%= suspicious.size %>)
              </summary>
              <div style="margin-top:0.5rem; display:flex; flex-direction:column; gap:0.5rem;">
                <% suspicious.each do |rev| %>
                  <% rev = rev.with_indifferent_access %>
                  <% is_fake = rev[:label] == "fake" %>
                  <div style="background:white; border:1px solid <%= is_fake ? '#fca5a5' : '#fde68a' %>; border-radius:0.5rem; padding:0.6rem 0.75rem; font-size:0.8rem;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                      <span style="font-weight:600; color:<%= cat[:txt] %>"><%= rev[:author_name] %> · <%= rev[:rating] %> ★</span>
                      <span style="font-size:0.75rem; font-weight:700; padding:0.1rem 0.4rem; border-radius:0.25rem; background:<%= is_fake ? '#fee2e2' : '#fef9c3' %>; color:<%= is_fake ? '#991b1b' : '#854d0e' %>;">
                        <%= is_fake ? "fake" : "uncertain" %> · score <%= rev[:computed_score] %>
                      </span>
                    </div>
                    <div style="color:#374151; margin-bottom:0.3rem;"><%= rev[:snippet] %></div>
                    <% breakdown = (rev[:score_breakdown] || {}).with_indifferent_access %>
                    <% if breakdown.any? %>
                      <div style="display:flex; flex-wrap:wrap; gap:0.3rem; margin-top:0.25rem;">
                        <% breakdown.each do |key, val| %>
                          <span style="font-size:0.7rem; padding:0.1rem 0.35rem; border-radius:0.25rem; background:<%= val.to_i > 0 ? '#fee2e2' : '#dcfce7' %>; color:<%= val.to_i > 0 ? '#991b1b' : '#166534' %>;">
                            <%= key %> <%= val.to_i > 0 ? "+#{val}" : val %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>

      <%# ── 4. KEY CONCLUSIONS ── %>
      <% conclusions = Array(analysis[:key_conclusions] || analysis[:key_tendencies]) %>
      <% if conclusions.any? %>
        <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:0.5rem; padding:1rem; margin-bottom:1rem;">
          <div style="font-size:0.78rem; font-weight:700; color:#1d4ed8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Key Conclusions</div>
          <ul style="font-size:0.875rem; color:#1e3a8a; margin:0; padding-left:1.25rem;">
            <% conclusions.first(7).each { |c| %><li><%= c %></li><% } %>
          </ul>
        </div>
      <% end %>

      <%# ── error ── %>
      <% if analysis[:error].present? %>
        <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:0.5rem; padding:1rem;">
          <div style="font-size:0.875rem; font-weight:700; color:#991b1b; margin-bottom:0.25rem;">Analysis Error</div>
          <div style="font-size:0.875rem; color:#b91c1c;"><%= analysis.dig(:error, :message) || analysis[:error] %></div>
        </div>
      <% end %>
    <% end %>
  </div>

  <script>
    document.getElementById('analyze-form').addEventListener('submit', function() {
      document.getElementById('loading-overlay').style.display = 'flex';
    });
  </script>

<% else %>

  <%# ── HERO ── %>
  <div class="card" style="text-align:center; padding:3.5rem 2rem; background:var(--primary-gradient); border:none; border-radius:1rem; color:white; margin-bottom:1.5rem;">
    <div style="font-size:3.5rem; margin-bottom:1rem; filter:drop-shadow(0 2px 8px rgba(0,0,0,0.3));">🕵️</div>
    <h1 style="font-size:2rem; font-weight:800; color:white; margin-bottom:0.75rem; letter-spacing:-0.02em;">
      Detect Fake Google Reviews
    </h1>
    <p style="font-size:1.05rem; color:#bfdbfe; max-width:480px; margin:0 auto 2rem; line-height:1.6;">
      AI-powered analysis that reveals manipulated ratings and identifies suspicious reviews
      for any Google Maps place — in seconds.
    </p>
    <%= button_to "Login with Google to Start", "/auth/google_oauth2", method: :post,
        data: { turbo: false },
        style: "padding:0.85rem 2.25rem; font-size:1rem; font-weight:700; background:white;
                color:#1e3a8a; border:none; border-radius:0.6rem; cursor:pointer;
                box-shadow:0 4px 14px rgba(0,0,0,0.25); transition:opacity .2s;
                display:inline-block;" %>
  </div>

  <%# ── FEATURES ── %>
  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:1.5rem;">
    <% [
      { icon: "🤖", title: "AI-Powered Classification",
        body: "Every review is individually scored by an LLM — real, fake, or uncertain — based on dozens of behavioural signals." },
      { icon: "📊", title: "Full Breakdown Report",
        body: "Positive / neutral / negative categories with fake rates, authenticity markers and suspicious-review details." },
      { icon: "⭐", title: "Corrected Rating",
        body: "We recalculate the rating counting fake reviews as neutral (2.5★), so you see what the real score should be." }
    ].each do |f| %>
      <div class="card" style="padding:1.4rem; margin-bottom:0;">
        <div style="font-size:2rem; margin-bottom:0.6rem;"><%= f[:icon] %></div>
        <div style="font-size:0.95rem; font-weight:700; color:var(--primary-color); margin-bottom:0.4rem;"><%= f[:title] %></div>
        <div style="font-size:0.82rem; color:var(--text-muted); line-height:1.55;"><%= f[:body] %></div>
      </div>
    <% end %>
  </div>

  <%# ── HOW IT WORKS ── %>
  <div class="card" style="margin-bottom:1.5rem;">
    <h2 style="font-size:1.1rem; font-weight:700; color:var(--primary-color); margin-bottom:1.25rem; text-align:center;">
      How it works
    </h2>
    <div style="display:flex; flex-direction:column; gap:1rem;">
      <% [
        { n: "1", title: "Find the Place ID",
          body: "Copy the Google Maps Place ID for any business (starts with ChIJ…). It's in the URL or via the Places API." },
        { n: "2", title: "Submit for Analysis",
          body: "Paste the ID into the input field. Our pipeline fetches the latest reviews via SerpAPI." },
        { n: "3", title: "AI Reads Every Review",
          body: "Each review is analyzed individually — language style, author profile, timing, edit history and more." },
        { n: "4", title: "Get Your Trust Report",
          body: "See the verdict (Trusted / Like Truth / Untrusted), fake counts per rating tier and key AI conclusions." }
      ].each do |step| %>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <div style="min-width:2rem; height:2rem; background:var(--primary-gradient); border-radius:50%;
                      display:flex; align-items:center; justify-content:center;
                      color:white; font-size:0.85rem; font-weight:800; flex-shrink:0;">
            <%= step[:n] %>
          </div>
          <div>
            <div style="font-size:0.9rem; font-weight:700; color:var(--text-main); margin-bottom:0.2rem;"><%= step[:title] %></div>
            <div style="font-size:0.82rem; color:var(--text-muted); line-height:1.5;"><%= step[:body] %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── BOTTOM CTA ── %>
  <div class="card" style="text-align:center; padding:2.5rem 1.5rem; border:2px dashed var(--border-color);">
    <p style="font-size:1rem; font-weight:600; color:var(--text-main); margin-bottom:1.25rem;">
      Ready to check a place?
    </p>
    <%= button_to "Login with Google", "/auth/google_oauth2", method: :post,
        class: "btn btn-primary", data: { turbo: false },
        style: "padding:0.75rem 2rem; font-size:1rem;" %>
  </div>

<% end %>
